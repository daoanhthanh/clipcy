---
import { featureSlides } from '../content/feature-slides.mjs';
const { catalog, locale } = Astro.props;
const slides = featureSlides(locale);
const controls = ({
  en: ['Previous feature', 'Next feature'],
  vi: ['Tính năng trước', 'Tính năng tiếp theo'],
  ja: ['前の機能', '次の機能'],
  ko: ['이전 기능', '다음 기능'],
  ru: ['Предыдущая функция', 'Следующая функция'],
  'zh-CN': ['上一个功能', '下一个功能'],
} as Record<string, string[]>)[locale] || ['Previous feature', 'Next feature'];
const copy = catalog.demo;
const items = ['clipcy.dev', copy.greeting, copy.speed, 'demo-notes.txt', 'window-wallpaper.jpg', copy.checklist, 'npm run dev', 'Alt + V', copy.nativeHistory, copy.reuse, copy.windowsClipboard, copy.steps];
const countForms = copy.itemCount;
const countLabel = countForms[new Intl.PluralRules(locale).select(items.length)] || countForms.other;
---
<div id="features" class="feature-slideshow" role="region" aria-label={catalog.features.heading} tabindex="0">
  <p class="visually-hidden" data-carousel-status aria-live="polite" aria-atomic="true"></p>
  {slides.map((slide, index) => <section id={index === 0 ? 'workflow' : `feature-${index + 1}`} class="feature-slide page-panel" data-feature-slide={index} aria-labelledby={`feature-title-${index}`}>
    <div class="container feature-slide-grid">
      <div class="slide-copy">
        <p class="eyebrow">{catalog.features.heading} <span class="slide-count">0{index + 1} / 05</span></p>
        <h2 id={`feature-title-${index}`}>{slide.title}</h2>
        <p class="slide-description">{slide.body}</p>
        <div class="slide-keys" aria-hidden="true">{slide.keys.map(key => <kbd>{key}</kbd>)}</div>
        <div class="slide-navigation">
          <nav class="slide-progress" aria-label={catalog.features.heading}>{slides.map((item, step) => <a href={step === 0 ? '#workflow' : `#feature-${step + 1}`} data-slide-target={step} aria-label={item.title} aria-current={step === index ? 'step' : undefined}><span class="visually-hidden">{item.title}</span></a>)}</nav>
        </div>
      </div>
      <figure class="slide-demo" aria-label={slide.title}>
        <button type="button" class="slide-arrow" data-slide-direction="-1" aria-label={controls[0]} hidden><span aria-hidden="true">←</span></button>
        <button type="button" class="slide-arrow" data-slide-direction="1" aria-label={controls[1]} hidden><span aria-hidden="true">→</span></button>
        <div class="slide-window clipboard-demo" data-locale={locale} data-count-forms={JSON.stringify(countForms)} data-pin-action={copy.pin} data-unpin-action={copy.unpin} data-file-content={copy.fileContent}>
          <div class="demo-menu">
            <div class="slide-search demo-search" aria-hidden="true"><span data-slide-query>{copy.search}</span><span class="slide-caret"></span></div>
            <div class="slide-rows demo-rows">
              {items.map((item, row) => <div class:list={['slide-row', 'demo-row', { 'is-selected': row === 2, 'demo-pinned-end': row === 1 }]} data-slide-row={row} data-label={item} data-pinned={String(row < 2)}>
                <svg viewBox="0 0 24 24" aria-hidden="true">{row === 3 ? <path d="M6 2h8l4 4v16H6zM14 2v5h4M9 12h6M9 16h6"/> : row === 4 ? <><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 17 6-6 4 4 3-3 5 5"/><circle cx="16" cy="7" r="1"/></> : <><rect x="8" y="3" width="12" height="14" rx="3"/><path d="M5 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2"/></>}</svg>
                <span>{index === 4 && row === 2 ? <strong class="slide-rich-text">{item}</strong> : item}</span>
                <svg class="slide-pin demo-pin" hidden={row >= 2} viewBox="0 0 24 24" aria-hidden="true"><path d="m16 3 5 5-4 2-3 6-3-3-7 7m4-9 6-3 2-5"/></svg>
                <kbd class="demo-row-shortcut">{row < 2 ? `Ctrl+Alt+${row === 0 ? 'F' : 'Z'}` : `Ctrl+${(row - 1) % 10}`}</kbd>
              </div>)}
            </div>
            <div class="demo-footer"><span data-slide-item-count>{countLabel.replace('{count}', String(items.length))}</span><span>{copy.settings}</span></div>
          </div>
          <aside class="demo-pane">
            <strong class="demo-preview-title">{copy.text}</strong>
            <p class="demo-content" data-slide-preview>{copy.speed}</p>
            <img class="demo-image" src="/window-wallpaper.jpg" alt="" width="2560" height="1600" hidden />
            <div class="demo-meta"><span class="demo-source"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#0098db" d="m17 2 6 3v14l-6 3-11-8-4 3-2-1V8l2-1 4 3Zm0 5-7 5 7 5ZM2 9v6l3-3Z"/></svg>Visual Studio Code</span><span data-slide-pin-action>{copy.pin}</span><span>{copy.copied}</span><span>{copy.delete}</span></div>
          </aside>
        </div>
        {index === 4 && <div class="slide-paste-target"><p class="eyebrow">{catalog.workflow.shortcuts.paste}</p><p data-paste-output>{copy.speed}</p></div>}
        <figcaption data-demo-key>{index === 1 ? '↑ / ↓ → Enter' : slide.keys.join(' + ')}</figcaption>
      </figure>
    </div>
  </section>)}
</div>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const carousel = document.querySelector<HTMLElement>('.feature-slideshow')!;
  const slides = [...carousel.querySelectorAll<HTMLElement>('[data-feature-slide]')];
  let selected = 0;
  const movingContent = '.slide-copy > :not(.eyebrow):not(.slide-navigation), .slide-demo';
  let schedulePlayback = () => {};
  const show = (index: number, focus?: string) => {
    const previous = selected;
    const navigationVisible = slides[previous].querySelector('.slide-navigation')!
      .classList.contains('reveal-visible');
    selected = (index + slides.length) % slides.length;
    slides[selected].querySelector('.slide-navigation')!
      .classList.toggle('reveal-visible', navigationVisible);
    slides.forEach((slide, step) => { slide.hidden = step !== selected; });
    if (selected !== previous && !reduced.matches) {
      const grid = slides[selected].querySelector<HTMLElement>('.feature-slide-grid')!;
      const fromLeft = index < previous || (previous === slides.length - 1 && selected === 0);
      const offset = grid.getBoundingClientRect().width * (fromLeft ? -1 : 1);
      slides[selected].querySelectorAll<HTMLElement>(movingContent).forEach(element => {
        element.getAnimations().forEach(animation => animation.cancel());
        element.animate([
          { transform: `translateX(${offset}px)` },
          { transform: 'translateX(0)' },
        ], { duration: 600, easing: 'cubic-bezier(.22, 1, .36, 1)' });
      });
    }
    carousel.querySelector<HTMLElement>('[data-carousel-status]')!.textContent =
      `${selected + 1} / ${slides.length}: ${slides[selected].querySelector('h2')!.textContent}`;
    carousel.dispatchEvent(new Event('featurechange'));
    if (focus) slides[selected].querySelector<HTMLElement>(focus)?.focus({ preventScroll: true });
    schedulePlayback();
  };
  const showHash = () => {
    const index = slides.findIndex(slide => `#${slide.id}` === location.hash);
    if (index >= 0) show(index);
  };
  carousel.querySelectorAll<HTMLButtonElement>('[data-slide-direction]').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', () => {
      show(selected + Number(button.dataset.slideDirection), `[data-slide-direction="${button.dataset.slideDirection}"]`);
      history.replaceState(null, '', `#${slides[selected].id}`);
    });
  });
  carousel.querySelectorAll<HTMLAnchorElement>('[data-slide-target]').forEach(link => {
    link.addEventListener('click', event => {
      event.preventDefault();
      show(Number(link.dataset.slideTarget), `[data-slide-target="${link.dataset.slideTarget}"]`);
      history.replaceState(null, '', link.hash);
    });
  });
  carousel.addEventListener('keydown', event => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    carousel.focus({ preventScroll: true });
    show(event.key === 'Home' ? 0 : event.key === 'End' ? slides.length - 1 : selected + (event.key === 'ArrowRight' ? 1 : -1));
    history.replaceState(null, '', `#${slides[selected].id}`);
  });
  let touchStart: { x: number; y: number } | undefined;
  carousel.addEventListener('pointerdown', event => {
    if (event.pointerType === 'touch') touchStart = { x: event.clientX, y: event.clientY };
  });
  carousel.addEventListener('pointercancel', () => { touchStart = undefined; });
  carousel.addEventListener('pointerup', event => {
    if (!touchStart) return;
    const dx = event.clientX - touchStart.x;
    const dy = event.clientY - touchStart.y;
    touchStart = undefined;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
      show(selected + (dx < 0 ? 1 : -1));
      history.replaceState(null, '', `#${slides[selected].id}`);
    }
  });
  window.addEventListener('hashchange', showHash);
  show(0);
  showHash();
  let playbackTimer: ReturnType<typeof setTimeout> | undefined;
  let carouselInView = false;
  schedulePlayback = () => {
    clearTimeout(playbackTimer);
    const demo = slides[selected].querySelector<HTMLElement>('.slide-demo')!;
    if (!carouselInView || document.hidden || reduced.matches
      || demo.matches(':hover') || carousel.matches(':focus-within')) return;
    playbackTimer = setTimeout(() => show(selected + 1), 6000);
  };
  slides.forEach(slide => {
    const demo = slide.querySelector<HTMLElement>('.slide-demo')!;
    demo.addEventListener('pointerenter', schedulePlayback);
    demo.addEventListener('pointerleave', schedulePlayback);
  });
  carousel.addEventListener('focusin', schedulePlayback);
  carousel.addEventListener('focusout', () => queueMicrotask(schedulePlayback));
  document.addEventListener('visibilitychange', schedulePlayback);
  reduced.addEventListener('change', () => {
    if (reduced.matches) slides.forEach(slide =>
      slide.querySelectorAll(movingContent).forEach(element =>
        element.getAnimations().forEach(animation => animation.cancel())));
    schedulePlayback();
  });
  new IntersectionObserver(entries => {
    carouselInView = entries[0].isIntersecting;
    schedulePlayback();
  }, { threshold: .2 }).observe(carousel);
  document.querySelectorAll<HTMLElement>('[data-feature-slide]').forEach(slide => {
    const kind = Number(slide.dataset.featureSlide);
    const rows = [...slide.querySelectorAll<HTMLElement>('[data-slide-row]')];
    const query = slide.querySelector<HTMLElement>('[data-slide-query]')!;
    const placeholder = query.textContent;
    const key = slide.querySelector<HTMLElement>('[data-demo-key]')!;
    const defaultKey = key.textContent;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let active = false;
    let inView = false;
    let tick = 0;
    const window = slide.querySelector<HTMLElement>('.slide-window')!;
    const pane = slide.querySelector<HTMLElement>('.demo-pane')!;
    const previewTitle = pane.querySelector<HTMLElement>('.demo-preview-title')!;
    const textTitle = previewTitle.textContent;
    const countForms = JSON.parse(window.dataset.countForms!);
    const pluralRules = new Intl.PluralRules(window.dataset.locale);
    const updateRows = () => {
      let regularIndex = 0;
      let pinnedIndex = 0;
      const ordered = [...slide.querySelectorAll<HTMLElement>('[data-slide-row]')];
      ordered.forEach(row => {
        const pinned = row.dataset.pinned === 'true';
        row.querySelector<SVGElement>('.slide-pin')!.toggleAttribute('hidden', !pinned);
        row.classList.remove('demo-pinned-end');
        const index = pinnedIndex;
        row.querySelector('kbd')!.textContent = pinned
          ? `Ctrl+Alt+${pinnedIndex++ === 0 ? 'F' : index === 1 ? 'Z' : index + 1}`
          : !row.hidden && ++regularIndex <= 10 ? `Ctrl+${regularIndex % 10}` : '';
      });
      ordered.filter(row => row.dataset.pinned === 'true' && !row.hidden).at(-1)?.classList.add('demo-pinned-end');
      const count = ordered.filter(row => !row.hidden).length;
      slide.querySelector('[data-slide-item-count]')!.textContent = (countForms[pluralRules.select(count)] || countForms.other).replace('{count}', String(count));
    };
    const select = (index: number) => {
      rows.forEach((row, i) => row.classList.toggle('is-selected', i === index && !row.hidden));
      const row = rows[index];
      pane.hidden = !row || row.hidden;
      if (pane.hidden) return;
      const content = slide.querySelector<HTMLElement>('[data-slide-preview]')!;
      content.textContent = index === 3 ? window.dataset.fileContent! : row.dataset.label || '';
      content.hidden = index === 4;
      pane.querySelector<HTMLImageElement>('.demo-image')!.hidden = index !== 4;
      previewTitle.textContent = index === 3 || index === 4 ? row.dataset.label || '' : textTitle;
      slide.querySelector('[data-slide-pin-action]')!.textContent = row.dataset.pinned === 'true' ? window.dataset.unpinAction! : window.dataset.pinAction!;
      const top = row.getBoundingClientRect().top - window.getBoundingClientRect().top;
      pane.style.setProperty('--preview-top', `${Math.min(top, Math.max(0, window.clientHeight - pane.offsetHeight))}px`);
    };
    const reset = () => {
      clearTimeout(timer);
      tick = 0;
      const list = slide.querySelector('.slide-rows')!;
      rows.forEach((row, index) => { row.hidden = false; row.dataset.pinned = String(index < 2); list.append(row); });
      query.textContent = placeholder;
      key.textContent = defaultKey;
      if (kind === 2 && reduced.matches) { rows[2].dataset.pinned = 'true'; list.prepend(rows[2]); }
      if (kind === 0 && reduced.matches) {
        query.textContent = 'demo-notes';
        rows.forEach(row => row.hidden = !row.dataset.label?.toLowerCase().includes('demo-notes'));
      }
      updateRows();
      select(kind === 0 && reduced.matches ? 3 : 2);
      slide.querySelector<HTMLElement>('[data-paste-output]')?.style.removeProperty('opacity');
      slide.querySelector('.slide-window')?.classList.remove('demo-pasted');
    };
    const frame = () => {
      if (!active || reduced.matches || document.hidden) return;
      const phase = tick++ % (kind === 0 ? 12 : 8);
      if (kind === 0) {
        const text = 'demo-notes'.slice(0, Math.min(phase, 10));
        query.textContent = text || placeholder;
        rows.forEach(row => row.hidden = !row.dataset.label?.toLowerCase().includes(text));
        updateRows();
        select(rows.findIndex(row => !row.hidden && row.dataset.pinned !== 'true'));
      } else if (kind === 1) {
        select(phase < 5 ? phase + 2 : 6);
        key.textContent = phase < 5 ? '↓' : 'Enter';
        slide.querySelector('.slide-window')?.classList.toggle('demo-pasted', phase >= 5);
      } else if (kind === 2) {
        rows[2].dataset.pinned = String(phase >= 3);
        const list = slide.querySelector('.slide-rows')!;
        rows.forEach(row => list.append(row));
        if (phase >= 3) list.prepend(rows[2]);
        updateRows();
        select(2);
        key.textContent = phase < 3 ? '↓' : 'Ctrl + P';
      } else if (kind === 3) {
        select(phase < 3 ? 2 : 4);
        key.textContent = phase < 3 ? 'Ctrl' : 'Ctrl + 3';
      } else {
        slide.querySelector('.slide-window')?.classList.toggle('demo-pasted', phase >= 3);
        const output = slide.querySelector<HTMLElement>('[data-paste-output]')!;
        output.style.opacity = phase < 3 ? '.2' : '1';
      }
      timer = setTimeout(frame, kind === 0 ? 450 : 650);
    };
    const sync = () => {
      active = inView && !slide.hidden;
      reset();
      if (active && !reduced.matches && !document.hidden) frame();
    };
    new IntersectionObserver(entries => {
      inView = entries[0].isIntersecting;
      sync();
    }, { threshold: .35 }).observe(slide);
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    carousel.addEventListener('featurechange', sync);
  });
</script>
<style>
  .feature-slideshow { touch-action: pan-y pinch-zoom; overflow-x: clip; }
  .feature-slide[hidden] { display: none; }
  .feature-slideshow:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .slide-navigation { display: flex; align-items: center; gap: 12px; margin-top: 36px; }
  .slide-arrow { position: absolute; inset-block: 0; z-index: 1; display: grid; place-items: center; width: clamp(44px, 12%, 64px); padding: 0; border: 0; border-radius: 0; color: #fff; font-size: 1.7rem; text-shadow: 0 2px 8px #102543; cursor: pointer; opacity: 0; pointer-events: none; transition: opacity 180ms; }
  .slide-arrow[data-slide-direction="-1"] { left: 0; border-radius: 12px 0 0 12px; background: linear-gradient(to right, #10254399, #10254340 55%, transparent); }
  .slide-arrow[data-slide-direction="1"] { right: 0; border-radius: 0 12px 12px 0; background: linear-gradient(to left, #10254399, #10254340 55%, transparent); }
  .slide-demo:hover .slide-arrow, .slide-demo:focus-within .slide-arrow { opacity: 1; pointer-events: auto; }
  @media (hover: none), (pointer: coarse) { .slide-arrow { opacity: 1; pointer-events: auto; } }
  @media (prefers-reduced-motion: reduce) { .slide-arrow { transition: none; } }
  .slide-arrow[hidden] { display: none; }
  .slide-arrow:hover span { transform: scale(1.15); }
  .slide-arrow:active span { transform: scale(.95); }
  .slide-arrow:focus-visible { outline: 2px solid #fff; outline-offset: -3px; }
  .feature-slide { background: radial-gradient(ellipse at 85% 35%, #cec5ff66, transparent 55%), linear-gradient(135deg, #f6faff, #edf3ff 60%, #f8f5ff); }
  .feature-slide:nth-child(even) { background: radial-gradient(ellipse at 20% 75%, #a3ccff80, transparent 55%), linear-gradient(135deg, #f8faff, #f0edff); }
  .feature-slide-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(32px, 6vw, 88px); width: 100%; }
  .slide-copy h2 { max-width: 17ch; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.13; }
  .slide-count { margin-left: 20px; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .slide-description { margin-top: 24px; color: var(--color-muted); font-size: 1.1rem; line-height: 1.75; max-width: 42ch; }
  .slide-keys { display: flex; gap: 10px; margin-top: 32px; }
  .slide-keys kbd { padding: 10px 16px; font-size: 1rem; background: #ffffffa6; border-bottom-width: 3px; }
  .slide-progress { display: flex; gap: 8px; }
  .slide-progress a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 4px; }
  .slide-progress a::after { content: ''; height: 3px; width: 32px; background: #b3c3dc; border-radius: 3px; }
  .slide-progress a[aria-current]::after { background: var(--color-accent); }
  .slide-progress a:focus-visible { outline: 2px solid var(--color-accent); }
  .slide-demo { position: relative; margin: 0; padding: 12px; border-radius: 12px; background: linear-gradient(140deg, #9ccdf180, #a9acdf66), url('/window-wallpaper.jpg') center / cover; }
  .slide-window { transition: opacity 300ms, transform 300ms; pointer-events: none; user-select: none; }
  .slide-search { display: flex; align-items: center; gap: 2px; overflow: hidden; white-space: nowrap; }
  .slide-search > span:first-child { overflow: hidden; text-overflow: ellipsis; }
  .slide-caret { width: 1px; height: 16px; flex-shrink: 0; background: #191919; }
  .slide-row.is-selected { background: #b9c0d4; border-right-color: #0078d4; }
  .slide-pin[hidden] { display: none; }
  figcaption { margin-top: 20px; color: #fff; text-align: center; font-family: var(--font-mono); }
  .slide-rich-text { font-style: italic; color: #191919; text-decoration: underline; }
  .slide-paste-target { background: #fffffff0; padding: 16px; margin-top: 16px; border-radius: 4px; }
  .slide-paste-target .eyebrow { font-size: .65rem; margin-bottom: 8px; }
  .slide-paste-target > p:last-child { margin: 0; color: var(--color-ink); font-size: .85rem; transition: opacity 250ms; }
  .demo-pasted { opacity: .65; transform: scale(.98); }
  @media (max-width: 700px) {
    .paged-home .feature-slide { padding-block: 24px; }
    .feature-slide-grid { grid-template-columns: 1fr; gap: 24px; }
    .slide-copy h2 { max-width: 24ch; }
    .slide-description { margin-top: 16px; font-size: 1rem; }
    .slide-keys { margin-top: 16px; }
    .slide-navigation { margin-top: 8px; gap: 8px; }
    .slide-progress { gap: 2px; }
    .slide-progress a { width: 36px; }
    .slide-demo { width: 100%; max-width: 460px; margin-inline: auto; padding: 20px; }
    .slide-demo figcaption { margin-top: 12px; font-size: .8rem; }
  }
</style>
