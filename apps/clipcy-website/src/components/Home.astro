---
import Base from '../layouts/Base.astro';
import SiteFooter from './SiteFooter.astro';
import WindowsShortcutText from './WindowsShortcutText.astro';
import ClipboardPreview from './ClipboardPreview.astro';
import FeatureSlideshow from './FeatureSlideshow.astro';
const { catalog, locale } = Astro.props;
---
<Base title={catalog.meta.title} description={catalog.meta.description} ogTitle={catalog.meta.ogTitle} ogDescription={catalog.meta.ogDescription} locale={locale} currentPath="/">
  <section class="hero page-panel"><div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span>{catalog.hero.eyebrow}</p>
      <h1>{catalog.hero.title}</h1><p class="hero-description">{catalog.hero.subtitle}</p>
      <div class="hero-actions"><button type="button" class="btn btn-primary" disabled>{catalog.hero.ctaStore}<svg class="microsoft-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M1 1h10v10H1zM13 1h10v10H13zM1 13h10v10H1zM13 13h10v10H13z" /></svg></button><span class="hero-action-separator">{catalog.hero.ctaOr}</span><a href={`/${locale}/download/`} class="btn btn-secondary">{catalog.hero.ctaDownload}<span aria-hidden="true">↓</span></a></div>
      <p class="hero-platform-note">{catalog.hero.windowsSupport}</p>
      <p class="release-note hero-license">{catalog.hero.freeOpenSource}</p>
    </div>
    <figure class="product-scene"><ClipboardPreview catalog={catalog}/></figure>
  </div></section>
  <FeatureSlideshow catalog={catalog} locale={locale} />
  <section id="comparison" class="comparison-section page-panel"><div class="container">
    <p class="eyebrow">{catalog.comparison.eyebrow}</p><h2><WindowsShortcutText text={catalog.comparison.heading} /></h2><p class="comparison-description">{catalog.comparison.body}</p>
    <div class="comparison-table-wrap"><table class="comparison-table">
      <thead><tr><td></td><th scope="col">Clipcy <kbd>Alt+V</kbd></th><th scope="col">{catalog.comparison.windows} <kbd><WindowsShortcutText text="Win+V" /></kbd></th></tr></thead>
      <tbody>{catalog.comparison.rows.map(row => <tr><th scope="row">{row.label}</th><td class:list={{ 'comparison-pro': row.clipcyPro, 'comparison-con': !row.clipcyPro }}><svg class:list={['comparison-mark', row.clipcyPro ? 'is-pro' : 'is-con']} aria-hidden="true" viewBox="0 0 22 22" width="22" height="22"><circle cx="11" cy="11" r="11" class="comparison-mark-circle" /><path d="M7 11h8" />{row.clipcyPro && <path d="M11 7v8" />}</svg><WindowsShortcutText text={row.clipcy} /></td><td class:list={{ 'comparison-pro': row.windowsPro, 'comparison-con': !row.windowsPro }}><svg class:list={['comparison-mark', row.windowsPro ? 'is-pro' : 'is-con']} aria-hidden="true" viewBox="0 0 22 22" width="22" height="22"><circle cx="11" cy="11" r="11" class="comparison-mark-circle" /><path d="M7 11h8" />{row.windowsPro && <path d="M11 7v8" />}</svg><WindowsShortcutText text={row.windows} /></td></tr>)}</tbody>
    </table></div>
    <div class="comparison-benefits">{catalog.comparison.benefits.map(benefit => <article class="comparison-benefit"><h3>{benefit.title}</h3><p>{benefit.body}</p></article>)}</div>
  </div></section>
  <section id="faq" class="faq-section page-panel"><div class="container">
    <h2>{catalog.faq.heading}</h2>
    <div class="faq-list">{[catalog.faq.q1, catalog.faq.q2, catalog.faq.q3, catalog.faq.q4].map(item => <details class="faq-item"><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
  </div></section>
  <section class="container page-panel final-page"><div class="final-cta"><img src="/assets/logo-192.png" alt="" width="56" height="56"/><h2>{catalog.finalCta.heading}</h2><p>{catalog.finalCta.body}</p><a class="btn btn-primary" href="https://github.com/daoanhthanh/clipcy">{catalog.finalCta.contribute}<svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.03-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.12-1.25-5.12-5.57 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.97 0 0 .95-.3 3.1 1.16A10.8 10.8 0 0 1 12 6.16c.96 0 1.92.13 2.82.38 2.15-1.46 3.1-1.16 3.1-1.16.61 1.54.23 2.68.11 2.97.72.79 1.16 1.8 1.16 3.03 0 4.33-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg></a></div><SiteFooter catalog={catalog} locale={locale} /></section>
</Base>
<script>
  const home = document.documentElement;
  if (home.classList.contains('paged-home')) {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (header) new ResizeObserver(() => home.style.setProperty('--header-height', `${header.getBoundingClientRect().height}px`)).observe(header);
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const elements = [...document.querySelectorAll<HTMLElement>(
      '.hero-copy > .eyebrow, .hero-copy > h1, .hero-description, .hero-platform-note, .hero-license, .hero-actions > .btn, .release-note, .product-scene, ' +
      '.slide-copy > :not(.eyebrow), .slide-demo, ' +
      '.comparison-section .eyebrow, .comparison-section h2, .comparison-description, .comparison-table-wrap, .comparison-benefit, ' +
      '.faq-section h2, .faq-item, .final-cta > *')];
    elements.forEach((element,index) => { element.classList.add('scroll-reveal'); element.style.setProperty('--reveal-delay', `${(index % 4)*45}ms`); });
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      const element = entry.target as HTMLElement;
      element.classList.toggle('reveal-visible', entry.isIntersecting && entry.intersectionRatio >= .15);
      element.style.setProperty('--reveal-offset', entry.boundingClientRect.top < 0 ? '-22px' : '22px');
    }), {threshold:[0,.15], rootMargin:'-5% 0px -5% 0px'});
    let entranceFrame = 0;
    let entranceCommitFrame = 0;
    const updateMotion = () => {
      observer.disconnect(); cancelAnimationFrame(entranceFrame); cancelAnimationFrame(entranceCommitFrame);
      home.classList.toggle('motion-ready', !motion.matches);
      if (!motion.matches) {
        elements.forEach(element => element.classList.remove('reveal-visible'));
        entranceFrame = requestAnimationFrame(() => { entranceCommitFrame = requestAnimationFrame(() => elements.forEach(element => observer.observe(element))); });
      }
    };
    updateMotion();
    let scrollFrame = 0;
    let scrollTarget = scrollY;
    let previousTime = 0;
    let scrollDirection = 0;
    const stopScroll = () => {
      cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      scrollTarget = scrollY;
    };
    const animateScroll = (time: number) => {
      const elapsed = Math.min(32, time - previousTime);
      previousTime = time;
      scrollTarget = Math.min(scrollTarget, Math.max(0, home.scrollHeight - innerHeight));
      const distance = scrollTarget - scrollY;
      if (Math.abs(distance) < .75) {
        window.scrollTo({ top: scrollTarget, behavior: 'instant' });
        scrollFrame = 0;
        return;
      }
      window.scrollTo({ top: scrollY + distance * (1 - Math.exp(-elapsed / 85)), behavior: 'instant' });
      scrollFrame = requestAnimationFrame(animateScroll);
    };
    window.addEventListener('wheel', event => {
      // Keep fine trackpad gestures and nested controls native.
      if (motion.matches || event.ctrlKey || !event.cancelable || Math.abs(event.deltaX) > Math.abs(event.deltaY) || (event.deltaMode === 0 && Math.abs(event.deltaY) < 40)) {
        stopScroll();
        return;
      }
      let target = event.target instanceof Element ? event.target : null;
      while (target && target !== document.body && target !== home) {
        const style = getComputedStyle(target);
        if (/auto|scroll/.test(style.overflowY) && target.scrollHeight > target.clientHeight + 1) {
          stopScroll();
          return;
        }
        target = target.parentElement;
      }
      const delta = event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? innerHeight : 1);
      if (!delta) return;
      const direction = Math.sign(delta);
      if (!scrollFrame || direction !== scrollDirection) scrollTarget = scrollY;
      scrollDirection = direction;
      const limit = Math.max(0, home.scrollHeight - innerHeight);
      scrollTarget = Math.max(0, Math.min(limit, scrollTarget + delta));
      event.preventDefault();
      if (!scrollFrame) {
        previousTime = performance.now();
        scrollFrame = requestAnimationFrame(animateScroll);
      }
    }, { passive: false });
    window.addEventListener('pointerdown', stopScroll, { passive: true });
    window.addEventListener('touchstart', stopScroll, { passive: true });
    window.addEventListener('keydown', stopScroll);
    window.addEventListener('resize', stopScroll);
    document.addEventListener('visibilitychange', stopScroll);
    motion.addEventListener('change', () => { stopScroll(); updateMotion(); });
  }
</script>
