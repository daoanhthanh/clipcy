---
import { wallpaperAlt } from '../content/feature-slides.mjs';
const { catalog, locale } = Astro.props;
const copy = catalog.demo;
const pluralRules = new Intl.PluralRules(locale);
const items = [
	{ type: "text", label: "clipcy.dev", content: "clipcy.dev" },
	{ type: "text", label: copy.greeting, content: copy.greeting },
	{ type: "text", label: copy.speed, content: copy.speed },
	{
		type: "file",
		label: "demo-notes.txt",
		content: copy.fileContent,
		source: "/assets/demo-notes.txt",
	},
	{
		type: "image",
		label: "window-wallpaper.jpg",
		content: "window-wallpaper.jpg",
		source: "/window-wallpaper-light.jpg",
	},
	{
		type: "text",
		label: copy.checklist,
		content: `${copy.checklist}\n${copy.steps}`,
	},
	{ type: "text", label: "npm run dev", content: "npm run dev" },
	{ type: "text", label: "Alt + V", content: "Alt + V" },
	{ type: "text", label: copy.nativeHistory, content: copy.nativeHistory },
	{ type: "text", label: copy.reuse, content: copy.reuse },
	{
		type: "text",
		label: copy.windowsClipboard,
		content: copy.windowsClipboard,
	},
	{ type: "text", label: copy.steps, content: copy.steps },
];
const initialCount =
	copy.itemCount[pluralRules.select(items.length)] || copy.itemCount.other;
---

<div
	class="clipboard-demo"
	data-clipboard-demo
	data-locale={locale}
	data-count-forms={JSON.stringify(copy.itemCount)}
	data-pin-action={copy.pin}
	data-unpin-action={copy.unpin}
>
	<svg class="demo-cursor" viewBox="0 0 24 28" aria-hidden="true" hidden
		><path d="M3 2v21l5-5 4 8 4-2-4-8h8Z"></path></svg
	>
	<span
		class="demo-shortcut-tip"
		data-pin-hint={catalog.hero.demoPinHint}
		data-unpin-hint={catalog.hero.demoUnpinHint}
		aria-hidden="true"
		hidden>{catalog.hero.demoPinHint}</span
	>
	<div class="demo-menu">
		<label class="visually-hidden" for="demo-search"
			>{catalog.features.find.title}</label
		>
		<div class="demo-search-wrap">
			<input
				id="demo-search"
				class="demo-search"
				type="search"
				placeholder={copy.search}
				autocomplete="off"
			/>
			<span class="demo-caret" aria-hidden="true" hidden></span>
		</div>
		<div class="demo-rows" aria-label={catalog.features.find.label}>
			<div class="demo-selection" aria-hidden="true" hidden></div>
			{
				items.map((item, index) => (
					<button
						type="button"
						class:list={["demo-row", { "demo-pinned-end": index === 1 }]}
						data-pinned={String(index < 2)}
						data-content={item.content}
						data-kind={item.type}
						data-label={item.label}
						data-source={item.source}
						aria-controls="demo-pane"
						aria-expanded="false"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							{item.type === "text" ? (
								<>
									<rect x="8" y="3" width="12" height="14" rx="3" />
									<path d="M5 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2" />
								</>
							) : item.type === "file" ? (
								<path d="M6 2h8l4 4v16H6zM14 2v5h4M9 12h6M9 16h6" />
							) : (
								<>
									<rect x="3" y="3" width="18" height="18" rx="2" />
									<path d="m3 17 6-6 4 4 3-3 5 5" />
									<circle cx="16" cy="7" r="1" />
								</>
							)}
						</svg>
						<span>{item.label}</span>
						<svg
							hidden={index >= 2}
							class="demo-pin"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path d="m16 3 5 5-4 2-3 6-3-3-7 7m4-9 6-3 2-5" />
						</svg>
						<kbd class="demo-row-shortcut">
							{index < 2
								? `Ctrl+Alt+${index === 0 ? "F" : "Z"}`
								: `Ctrl+${(index - 1) % 10}`}
						</kbd>
					</button>
				))
			}
		</div>
		<div class="demo-footer">
			<span class="demo-item-count" aria-live="polite"
				>{initialCount.replace("{count}", String(items.length))}</span
			><span>{copy.settings}</span>
		</div>
	</div>
	<aside
		id="demo-pane"
		class="demo-pane"
		aria-label={catalog.features.preview.title}
		hidden
	>
		<strong class="demo-preview-title">{copy.text}</strong>
		<div class="demo-preview-body">
			<p class="demo-content"></p>
			<img
				class="demo-image" data-theme-wallpaper
				src="/window-wallpaper-light.jpg"
				alt={wallpaperAlt(locale)}
				width="2560"
				height="1600"
				hidden
			/>
		</div>
		<div class="demo-meta">
			<span class="demo-source"
				><svg viewBox="0 0 24 24" aria-hidden="true"
					><path
						fill="#0098db"
						d="m17 2 6 3v14l-6 3-11-8-4 3-2-1V8l2-1 4 3Zm0 5-7 5 7 5ZM2 9v6l3-3Z"
					></path></svg
				>Visual Studio Code</span
			><span class="demo-pin-action">{copy.pin}</span><span>{copy.copied}</span
			><span>{copy.delete}</span>
		</div>
	</aside>
</div>
<script>
	document
		.querySelectorAll<HTMLElement>("[data-clipboard-demo]")
		.forEach((demo) => {
			const countForms = JSON.parse(demo.dataset.countForms!);
			const pluralRules = new Intl.PluralRules(demo.dataset.locale);
			const pane = demo.querySelector<HTMLElement>(".demo-pane")!;
			const previewTitle = demo.querySelector<HTMLElement>(
				".demo-preview-title",
			)!;
			const textPreviewTitle = previewTitle.textContent;
			const previewBody =
				demo.querySelector<HTMLElement>(".demo-preview-body")!;
			const previewImage = demo.querySelector<HTMLImageElement>(".demo-image")!;
			const content = demo.querySelector<HTMLElement>(".demo-content")!;
			const rows = [...demo.querySelectorAll<HTMLButtonElement>(".demo-row")];
			const search = demo.querySelector<HTMLInputElement>(".demo-search")!;
			const selection = demo.querySelector<HTMLElement>(".demo-selection")!;
			const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
			let paneAnimation: Animation | undefined;
			let contentAnimation: Animation | undefined;
			let activeRow: HTMLButtonElement | undefined;
			const close = () => {
				paneAnimation?.cancel();
				contentAnimation?.cancel();
				activeRow = undefined;
				selection.hidden = true;
				pane.hidden = true;
				rows.forEach((row) => row.setAttribute("aria-expanded", "false"));
			};
			const show = (row: HTMLButtonElement) => {
				if (activeRow === row && !pane.hidden) return;
				const wasHidden = pane.hidden;
				const previous = pane.getBoundingClientRect();
				paneAnimation?.cancel();
				contentAnimation?.cancel();
				activeRow = row;
				demo.querySelector(".demo-pin-action")!.textContent =
					row.dataset.pinned === "true"
						? demo.dataset.unpinAction!
						: demo.dataset.pinAction!;
				rows.forEach((item) =>
					item.setAttribute("aria-expanded", String(item === row)),
				);
				const isImage = row.dataset.kind === "image";
				previewTitle.textContent =
					row.dataset.kind === "text"
						? textPreviewTitle
						: row.dataset.label || "";
				content.textContent = row.dataset.content || "";
				content.hidden = isImage;
				content.classList.toggle(
					"demo-file-content",
					row.dataset.kind === "file",
				);
				previewImage.hidden = !isImage;
				if (isImage) {
					previewImage.src = `/window-wallpaper-${document.documentElement.dataset.theme === "dark" ? "dark" : "light"}.jpg`;
				}
				pane.hidden = false;
				selection.hidden = false;
				selection.style.transform = `translateY(${row.offsetTop}px)`;
				selection.style.height = `${row.offsetHeight}px`;
				const desiredTop =
					row.getBoundingClientRect().top - demo.getBoundingClientRect().top;
				pane.style.setProperty(
					"--preview-top",
					`${Math.min(desiredTop, Math.max(0, demo.clientHeight - pane.offsetHeight))}px`,
				);
				if (reducedMotion.matches) return;
				const next = pane.getBoundingClientRect();
				// FLIP preserves the visible position when fast hover changes interrupt a morph.
				const from = wasHidden
					? "translate(-8px, 0) scale(.96)"
					: `translate(${previous.left - next.left}px, ${previous.top - next.top}px) scale(${previous.width / next.width}, ${previous.height / next.height})`;
				paneAnimation = pane.animate(
					[
						{ transform: from, opacity: wasHidden ? 0 : 1 },
						{ transform: "translate(0, 0) scale(1)", opacity: 1 },
					],
					{ duration: 340, easing: "cubic-bezier(.22, 1, .36, 1)" },
				);
				contentAnimation = previewBody.animate(
					[
						{ opacity: 0.25, transform: "translateY(4px)" },
						{ opacity: 1, transform: "translateY(0)" },
					],
					{ duration: 240, easing: "ease-out" },
				);
			};
			reducedMotion.addEventListener("change", () => {
				if (reducedMotion.matches) {
					paneAnimation?.cancel();
					contentAnimation?.cancel();
				}
			});
			const updateShortcuts = () => {
				let regularIndex = 0;
				let pinnedIndex = 0;
				demo.querySelectorAll<HTMLButtonElement>(".demo-row").forEach((row) => {
					let shortcut = "";
					if (row.dataset.pinned === "true") {
						const index = pinnedIndex++;
						shortcut = `Ctrl+Alt+${index === 0 ? "F" : index === 1 ? "Z" : index + 1}`;
					} else if (!row.hidden && ++regularIndex <= 10) {
						shortcut = `Ctrl+${regularIndex % 10}`;
					}
					row.querySelector(".demo-row-shortcut")!.textContent = shortcut;
				});
			};
			const reorder = () => {
				const ordered = [
					...rows.filter((row) => row.dataset.pinned === "true"),
					...rows.filter((row) => row.dataset.pinned !== "true"),
				];
				ordered.forEach((row) => {
					row.classList.remove("demo-pinned-end");
					demo.querySelector(".demo-rows")!.append(row);
					row
						.querySelector<SVGElement>(".demo-pin")!
						.toggleAttribute("hidden", row.dataset.pinned !== "true");
				});
				ordered
					.filter((row) => row.dataset.pinned === "true")
					.at(-1)
					?.classList.add("demo-pinned-end");
				updateShortcuts();
				const current = activeRow;
				activeRow = undefined;
				if (current && !current.hidden) show(current);
			};
			const togglePin = (row: HTMLButtonElement) => {
				row.dataset.pinned = String(row.dataset.pinned !== "true");
				reorder();
			};
			demo.addEventListener("keydown", (event) => {
				if (event.ctrlKey && event.key.toLowerCase() === "p" && activeRow) {
					event.preventDefault();
					togglePin(activeRow);
				}
			});
			rows.forEach((row) => {
				row.addEventListener("pointerenter", (event) => {
					if (event.pointerType !== "touch") show(row);
				});
				row.addEventListener("focus", () => show(row));
				row.addEventListener("click", () => show(row));
				row.addEventListener("keydown", (event) => {
					if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
					event.preventDefault();
					const visible = [
						...demo.querySelectorAll<HTMLButtonElement>(".demo-row"),
					].filter((item) => !item.hidden);
					const next =
						visible.indexOf(row) + (event.key === "ArrowDown" ? 1 : -1);
					visible[(next + visible.length) % visible.length]?.focus();
				});
			});
			demo.addEventListener("pointerleave", (event) => {
				if (
					event.pointerType !== "touch" &&
					!demo.contains(document.activeElement)
				)
					close();
			});
			demo.addEventListener("focusout", (event) => {
				if (!demo.contains(event.relatedTarget as Node)) close();
			});
			demo.addEventListener("keydown", (event) => {
				if (event.key === "Escape") close();
			});
			search.addEventListener("input", () => {
				close();
				const query = search.value.trim().toLocaleLowerCase();
				rows.forEach((row) => {
					row.hidden = !`${row.dataset.label} ${row.dataset.content}`
						.toLocaleLowerCase()
						.includes(query);
				});
				updateShortcuts();
				const count = rows.filter((row) => !row.hidden).length;
				demo.querySelector(".demo-item-count")!.textContent = (
					countForms[pluralRules.select(count)] || countForms.other
				).replace("{count}", String(count));
			});
			search.addEventListener("keydown", (event) => {
				if (event.key === "ArrowDown") {
					event.preventDefault();
					rows.find((row) => !row.hidden)?.focus();
				}
			});
			const cursor = demo.querySelector<SVGElement>(".demo-cursor")!;
			const shortcutTip =
				demo.querySelector<HTMLElement>(".demo-shortcut-tip")!;
			let timer: ReturnType<typeof setTimeout> | undefined;
			let stopped = false;
			let visible = false;
			let step = 0;
			const move = (element: Element) => {
				const target = element.getBoundingClientRect();
				const bounds = demo.getBoundingClientRect();
				const x = target.left - bounds.left + target.width * 0.65;
				const y = target.top - bounds.top + target.height * 0.55;
				cursor.style.transform = `translate(${x}px, ${y}px)`;
				shortcutTip.style.transform = `translate(${x + 25}px, ${y + 28}px)`;
			};
			const caret = demo.querySelector<HTMLElement>(".demo-caret")!;
			const measure = document.createElement("canvas").getContext("2d");
			let actionDelay = 1400;
			const updateCaret = () => {
				const style = getComputedStyle(search);
				if (measure) measure.font = `${style.fontSize} ${style.fontFamily}`;
				const width = measure?.measureText(search.value).width || 0;
				caret.style.left = `${Math.min(search.clientWidth - 15, parseFloat(style.paddingLeft) + width + 1)}px`;
			};
			const filter = (value: string) => {
				search.value = value;
				search.dispatchEvent(new Event("input"));
				updateCaret();
			};
			const reset = () => {
				shortcutTip.hidden = true;
				caret.hidden = true;
				filter("");
				rows.forEach((row, index) => {
					row.dataset.pinned = String(index < 2);
				});
				reorder();
				close();
			};
			show(rows[2]);
			// One timer and transform-only cursor motion keep the tour inexpensive.
			const actions = [
				() => {
					move(rows[2]);
					show(rows[2]);
				},
				() => {
					move(rows[3]);
					show(rows[3]);
				},
				() => {
					move(rows[4]);
					show(rows[4]);
				},
				() => {
					move(search);
					close();
					caret.hidden = false;
					updateCaret();
				},
				...[..."demo-notes"].map((_, index) => () => {
					caret.hidden = false;
					filter("demo-notes".slice(0, index + 1));
					actionDelay = index === 9 ? 1400 : 160;
				}),
				() => {
					caret.hidden = true;
					move(rows[3]);
					show(rows[3]);
				},
				() => {
					filter("");
					move(rows[5]);
					show(rows[5]);
				},
				() => {
					shortcutTip.textContent =
						rows[5].dataset.pinned === "true"
							? shortcutTip.dataset.unpinHint!
							: shortcutTip.dataset.pinHint!;
					shortcutTip.hidden = false;
					move(rows[5]);
				},
				() => {
					shortcutTip.hidden = true;
					togglePin(rows[5]);
					move(rows[5]);
				},
				() => {
					shortcutTip.textContent =
						rows[5].dataset.pinned === "true"
							? shortcutTip.dataset.unpinHint!
							: shortcutTip.dataset.pinHint!;
					shortcutTip.hidden = false;
					move(rows[5]);
				},
				() => {
					shortcutTip.hidden = true;
					togglePin(rows[5]);
					move(rows[5]);
				},
				() => {
					reset();
				},
			];
			const run = () => {
				if (stopped || !visible || document.hidden || reducedMotion.matches)
					return;
				cursor.removeAttribute("hidden");
				actionDelay = 1400;
				actions[step]();
				step = (step + 1) % actions.length;
				timer = setTimeout(run, step === 0 ? 2400 : actionDelay);
			};
			const pause = () => {
				clearTimeout(timer);
				cursor.setAttribute("hidden", "");
				shortcutTip.hidden = true;
				caret.hidden = true;
			};
			let idleTimer: ReturnType<typeof setTimeout> | undefined;
			const takeOver = (event: Event) => {
				// Automated search events must not interrupt their own demo sequence.
				if (!event.isTrusted) return;
				const wasRunning = !stopped;
				stopped = true;
				pause();
				if (wasRunning) reset();
				clearTimeout(idleTimer);
				idleTimer = setTimeout(() => {
					stopped = false;
					step = 0;
					reset();
					run();
				}, 1500);
			};
			[
				"pointerenter",
				"pointermove",
				"pointerdown",
				"keydown",
				"input",
				"focusin",
				"wheel",
			].forEach((type) => {
				demo.addEventListener(type, takeOver, { passive: true });
			});
			const observer = new IntersectionObserver(
				(entries) => {
					visible = entries[0].isIntersecting;
					pause();
					if (visible) timer = setTimeout(run, 1200);
				},
				{ threshold: 0.5 },
			);
			observer.observe(demo);
			document.addEventListener("visibilitychange", () => {
				pause();
				if (!document.hidden) timer = setTimeout(run, 1200);
			});
			reducedMotion.addEventListener("change", () => {
				pause();
				if (!reducedMotion.matches) run();
			});
			document.addEventListener("pointerdown", (event) => {
				if (!demo.contains(event.target as Node)) close();
			});
		});
</script>
