---
const { copy } = Astro.props;
---
<button type="button" class="theme-picker" data-theme-toggle data-light-label={copy.light} data-dark-label={copy.dark} aria-label={copy.label} aria-pressed="false" title={copy.label}>
    <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.5A9 9 0 0 1 8.5 4 9 9 0 1 0 20 15.5Z"/></svg>

</button>
