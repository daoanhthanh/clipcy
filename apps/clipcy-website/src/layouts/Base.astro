---
import ThemePicker from '../components/ThemePicker.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/themes.css';
import { locales } from '../locales.mjs';
import * as catalogs from '../content/index.mjs';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  locale: string;
  currentPath: string;
}

const { title, description, ogTitle, ogDescription, locale, currentPath } = Astro.props;
const catalog = catalogs[locale === 'zh-CN' ? 'zhCN' : locale];
const siteUrl = 'https://clipcy.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html>
<html lang={locale} class:list={{ 'paged-home': currentPath === '/' }}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline src="/theme.js"></script>
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={ogTitle || title}>
  <meta property="og:description" content={ogDescription || description}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:image" content={`${siteUrl}/assets/logo-512.png`}>
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:locale" content={locale.replace('-', '_')}>
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={ogTitle || title}>
  <meta name="twitter:description" content={ogDescription || description}>
  <meta name="twitter:image" content={`${siteUrl}/assets/logo-512.png`}>
  
  <link rel="canonical" href={canonicalURL}>
  <link rel="icon" href="/assets/favicon.ico">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  

</head>
<body>
  <a href="#main" class="skip-link">{catalog.a11y.skipToMain}</a>
  
  <header class="site-header">
    <nav class="container header-content" aria-label="Main navigation">
      <a href={`/${locale}/`} class="logo">
        <img src="/assets/logo-192.png" alt="" width="32" height="32">
        <span>Clipcy</span>
      </a>
      
      <ul class="nav-links">
        <li><a class="github-link" href="https://github.com/daoanhthanh/clipcy" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.03-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.12-1.25-5.12-5.57 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.97 0 0 .95-.3 3.1 1.16A10.8 10.8 0 0 1 12 6.16c.96 0 1.92.13 2.82.38 2.15-1.46 3.1-1.16 3.1-1.16.61 1.54.23 2.68.11 2.97.72.79 1.16 1.8 1.16 3.03 0 4.33-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg></a></li>
        <li><a href={`/${locale}/download/`}>{catalog.nav.download}</a></li>
        <li><ThemePicker copy={catalog.theme} /></li>
        <li>
          <details class="language-picker">
            <summary aria-label={catalog.nav.chooseLanguage}>{locale.toUpperCase()} <svg class="language-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
            <div class="language-options">
              {locales.map(language => <a href={`/${language.code}${currentPath}`} lang={language.code} aria-current={language.code === locale ? 'true' : undefined}>{language.nativeName}</a>)}
            </div>
          </details>
        </li>
      </ul>
    </nav>
  </header>
  
  <main id="main">
    <slot />
  </main>
  
  {currentPath !== '/' && <SiteFooter catalog={catalog} locale={locale} />}
</body>
</html>
