<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Clipcy.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Clipcy"
  xmlns:controls="using:Clipcy.Controls"
  xmlns:services="using:Clipcy.Services"
>
  <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar drag region -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="8">
        <!-- Hamburger menu button (shown when sidebar is collapsed) -->
        <Button
          x:Name="HamburgerButton"
          Width="40"
          Height="40"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          Click="HamburgerButton_Click"
          Visibility="Collapsed"
        >
          <FontIcon Glyph="&#xE700;" FontSize="16" />
        </Button>
        <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="20" Height="20" VerticalAlignment="Center" />
        <TextBlock
          services:Localization.Text="settings.title"
          Style="{StaticResource BodyTextBlockStyle}"
          VerticalAlignment="Center"
        />
      </StackPanel>
    </Grid>

    <!-- Main Content Area -->
    <Grid Grid.Row="1">
      <!-- Content Panel (always full width) -->
      <Grid x:Name="ContentAreaGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Spacer for sidebar in expanded mode -->
        <Border x:Name="SidebarSpacer" Grid.Column="0" />

        <!-- Content takes the right column in expanded mode, or full width in compact -->
        <Grid x:Name="ContentPanel" Grid.Column="1" Background="Transparent">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Page content area -->
          <ScrollViewer Grid.Row="0" Padding="24,32,24,32">
            <Grid x:Name="ContentHost" MaxWidth="2400" HorizontalAlignment="Stretch">
              <!-- General Page -->
              <StackPanel
                x:Name="GeneralPage"
                Spacing="8"
                Visibility="Visible"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  services:Localization.Text="settings.general"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  services:Localization.Text="settings.general_desc"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <controls:SettingsCard
                  services:Localization.Header="settings.language"
                  services:Localization.Description="settings.language_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE775;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ComboBox
                    x:Name="LanguageComboBox"
                    MinWidth="150"
                    DisplayMemberPath="NativeName"
                    SelectedValuePath="Code"
                    SelectionChanged="LanguageComboBox_SelectionChanged"
                    VerticalAlignment="Center"
                  />
                </controls:SettingsCard>

                <!-- Max History Items -->
                <controls:SettingsCard
                  services:Localization.Header="settings.max_history"
                  services:Localization.Description="settings.max_history_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE81C;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <NumberBox
                    x:Name="MaxHistoryBox"
                    MinWidth="120"
                    Minimum="25"
                    Maximum="1000"
                    SpinButtonPlacementMode="Hidden"
                    ValueChanged="MaxHistoryBox_ValueChanged"
                    LostFocus="MaxHistoryBox_LostFocus"
                    VerticalAlignment="Center"
                  />
                </controls:SettingsCard>

                <!-- Hotkey -->
                <controls:SettingsCard
                  services:Localization.Header="settings.hotkey"
                  services:Localization.Description="settings.hotkey_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE765;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding HotkeyParts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                          >
                            <TextBlock
                              Text="{Binding}"
                              FontSize="12"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              VerticalAlignment="Center"
                            />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Click="EditHotkey_Click" Style="{StaticResource IconHoverButtonStyle}">
                      <FontIcon
                        Glyph="&#xE104;"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      />
                    </Button>
                  </StackPanel>
                </controls:SettingsCard>
              </StackPanel>

              <!-- Behavior Page -->
              <StackPanel
                x:Name="BehaviorPage"
                Spacing="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  services:Localization.Text="settings.behavior"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  services:Localization.Text="settings.behavior_desc"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <!-- Start on boot -->
                <controls:SettingsCard
                  services:Localization.Header="settings.start_on_boot"
                  services:Localization.Description="settings.start_on_boot_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE7E8;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="StartOnBootToggle"
                    Toggled="StartOnBootToggle_Toggled"
                    services:Localization.OnContent="common.on"
                    services:Localization.OffContent="common.off"
                  />
                </controls:SettingsCard>

                <!-- Show preview panel -->
                <controls:SettingsCard
                  services:Localization.Header="settings.show_preview"
                  services:Localization.Description="settings.show_preview_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE8A1;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="ShowPreviewToggle"
                    Toggled="ShowPreviewToggle_Toggled"
                    services:Localization.OnContent="common.on"
                    services:Localization.OffContent="common.off"
                  />
                </controls:SettingsCard>

                <controls:SettingsCard
                  services:Localization.Header="settings.respect_clipboard_exclusion"
                  services:Localization.Description="settings.respect_clipboard_exclusion_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE72E;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="RespectClipboardExclusionToggle"
                    Toggled="RespectClipboardExclusionToggle_Toggled"
                    services:Localization.OnContent="common.on"
                    services:Localization.OffContent="common.off"
                  />
                </controls:SettingsCard>
                <InfoBar
                  x:Name="ClipboardExclusionErrorInfoBar"
                  IsOpen="False"
                  Severity="Error"
                  IsClosable="True"
                />

                <!-- Show notifications -->
                <!-- <controls:SettingsCard
                  services:Localization.Header="settings.show_notifications"
                  services:Localization.Description="settings.show_notifications_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE91C;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="ShowNotificationsToggle"
                    Toggled="ShowNotificationsToggle_Toggled"
                    services:Localization.OnContent="common.on"
                    services:Localization.OffContent="common.off"
                  />
                </controls:SettingsCard> -->

                <!-- Excluded apps (collapsible section) -->
                <Expander
                  IsExpanded="False"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="0,0,0,12"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                >
                  <Expander.Header>
                    <Grid HorizontalAlignment="Stretch" Margin="8,20,8,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <FontIcon
                        Grid.Column="0"
                        Glyph="&#xF71D;"
                        FontSize="20"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                      />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                          services:Localization.Text="settings.excluded_apps"
                          Style="{StaticResource BodyStrongTextBlockStyle}"
                        />
                        <TextBlock
                          services:Localization.Text="settings.excluded_apps_desc"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                        />
                      </StackPanel>
                    </Grid>
                  </Expander.Header>
                  <Expander.Content>
                    <StackPanel Margin="8,0,8,20" Spacing="8">
                      <TextBox
                        x:Name="ExcludedAppsTextBox"
                        services:Localization.PlaceholderText="settings.excluded_apps_placeholder"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        MinHeight="120"
                        MaxHeight="10000"
                        TextChanged="ExcludedAppsTextBox_TextChanged"
                        LostFocus="ExcludedAppsTextBox_LostFocus"
                      />
                    </StackPanel>
                  </Expander.Content>
                </Expander>
              </StackPanel>

              <!-- Appearance Page -->
              <StackPanel
                x:Name="AppearancePage"
                Spacing="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  services:Localization.Text="settings.appearance"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  services:Localization.Text="settings.appearance_desc"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <!-- Theme -->
                <controls:SettingsCard
                  services:Localization.Header="settings.theme"
                  services:Localization.Description="settings.theme_desc"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE793;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ComboBox
                    x:Name="ThemeComboBox"
                    MinWidth="150"
                    SelectionChanged="ThemeComboBox_SelectionChanged"
                    VerticalAlignment="Center"
                    Margin="4 0 0 0"
                  >
                    <ComboBoxItem services:Localization.Content="settings.theme_system" Tag="System" />
                    <ComboBoxItem services:Localization.Content="settings.theme_light" Tag="Light" />
                    <ComboBoxItem services:Localization.Content="settings.theme_dark" Tag="Dark" />
                  </ComboBox>
                </controls:SettingsCard>
              </StackPanel>

              <!-- About Page -->
              <StackPanel
                x:Name="AboutPage"
                Spacing="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  services:Localization.Text="settings.about"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  services:Localization.Text="settings.about_desc"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <Expander
                  IsExpanded="False"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Margin="0,0,0,12"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                >
                  <Expander.Header>
                    <Grid HorizontalAlignment="Stretch" Margin="8,20,8,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Image
                        Grid.Column="0"
                        Source="ms-appx:///Assets/Square44x44Logo.png"
                        Width="44"
                        Height="44"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                      />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                          Text="Clipcy"
                          Style="{StaticResource BodyStrongTextBlockStyle}"
                        />
                        <TextBlock
                          x:Name="UpdateLastCheckedText"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        />
                      </StackPanel>
                      <TextBlock
                        Grid.Column="2"
                        x:Name="AppVersionText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                      />
                    </Grid>
                  </Expander.Header>
                  <Expander.Content>
                    <StackPanel Spacing="12" Margin="8,12,8,20">
                      <TextBlock
                        x:Name="UpdateStatusText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                          x:Name="CheckUpdatesButton"
                          services:Localization.Content="update.check_now"
                          Click="CheckUpdatesButton_Click"
                        />
                        <Button
                          x:Name="OpenReleasePageButton"
                          services:Localization.Content="update.github_releases"
                          Click="OpenReleasePageButton_Click"
                        />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                          services:Localization.Text="update.auto_update"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"
                        />
                        <ToggleSwitch
                          x:Name="AutoUpdateToggle"
                          Toggled="AutoUpdateToggle_Toggled"
                          services:Localization.OnContent="update.auto_update_desc"
                          OffContent=""
                        />
                      </StackPanel>
                    </StackPanel>
                  </Expander.Content>
                </Expander>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <InfoBar
            x:Name="LanguageErrorInfoBar"
            Grid.Row="1"
            Margin="24,0,24,24"
            IsOpen="False"
            Severity="Error"
            IsClosable="True"
          />
        </Grid>
      </Grid>

      <!-- Overlay backdrop for compact mode (click to close sidebar) -->
      <Border
        x:Name="SidebarOverlayBackdrop"
        Background="#80000000"
        Visibility="Collapsed"
        Tapped="SidebarOverlayBackdrop_Tapped"
      />

      <!-- Sidebar Panel (overlays content in compact mode) -->
      <Grid x:Name="SidebarPanel" Width="280" HorizontalAlignment="Left">
        <!-- Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" -->
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
          x:Name="NavListView"
          Grid.Row="0"
          Padding="12,8"
          SelectionMode="Single"
          SelectedIndex="0"
          Background="Transparent"
          SelectionChanged="NavListView_SelectionChanged"
        >
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="12,10" />
              <Setter Property="Margin" Value="4,2" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>

          <ListViewItem Tag="General">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE115;" FontSize="16" />
              <TextBlock services:Localization.Text="settings.general" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>

          <ListViewItem Tag="Behavior">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE9E9;" FontSize="16" />
              <TextBlock services:Localization.Text="settings.behavior" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>

          <ListViewItem Tag="Appearance">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE790;" FontSize="16" />
              <TextBlock services:Localization.Text="settings.appearance" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>

          <ListViewItem Tag="About">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE946;" FontSize="16" />
              <TextBlock services:Localization.Text="settings.about" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
        </ListView>

        <!-- Reset button at bottom of sidebar -->
        <Button
          services:Localization.Content="settings.reset_defaults"
          Grid.Row="1"
          Margin="16,8,16,16"
          HorizontalAlignment="Stretch"
          Click="ResetButton_Click"
        />
      </Grid>
    </Grid>
  </Grid>
</Window>
