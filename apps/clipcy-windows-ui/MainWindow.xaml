<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Clipcy.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Clipcy"
  xmlns:vm="using:Clipcy.ViewModels"
>
  <Grid
    x:Name="RootGrid"
    KeyDown="RootGrid_KeyDown"
    Background="Transparent"
    Padding="8"
    IsTabStop="True"
  >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search Box -->
    <TextBox
      x:Name="SearchBox"
      Grid.Row="0"
      Margin="4,4,4,4"
      PlaceholderText="Search clipboard history..."
      TextChanged="SearchBox_TextChanged"
      GotFocus="SearchBox_GotFocus"
      BorderThickness="0"
      Background="{ThemeResource ControlFillColorDefaultBrush}"
    />

    <!-- Clipboard History List -->
    <ListView
      x:Name="HistoryListView"
      Grid.Row="1"
      Margin="0,4,0,0"
      ItemsSource="{Binding ViewModel.Items}"
      SelectionMode="Single"
      ItemClick="HistoryListView_ItemClick"
      IsItemClickEnabled="True"
      SingleSelectionFollowsFocus="False"
      Background="Transparent"
      ContainerContentChanging="HistoryListView_ContainerContentChanging"
      Loaded="HistoryListView_Loaded"
    >
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Padding" Value="8,6" />
          <Setter Property="Margin" Value="4,1" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="{Binding PinUnpinText}" Click="PinUnpinMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete" Click="DeleteMenuItem_Click" />
              </MenuFlyout>
            </Grid.ContextFlyout>

            <!-- Content Type Icon -->
            <FontIcon
              Grid.Column="0"
              FontSize="14"
              Glyph="{Binding ContentTypeIcon}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              VerticalAlignment="Center"
            />

            <!-- Content Preview (Text or Image Thumbnail) -->
            <Grid Grid.Column="1" ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border
                Grid.Column="0"
                CornerRadius="3"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                VerticalAlignment="Center"
              >
                <Image
                  Source="{Binding ThumbnailImage}"
                  Width="32"
                  Height="32"
                  Stretch="UniformToFill"
                />
              </Border>

              <TextBlock
                Grid.Column="1"
                Text="{Binding Preview}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                VerticalAlignment="Center"
                FontSize="13"
              />
            </Grid>

            <!-- Pin Icon -->
            <FontIcon
              Grid.Column="2"
              FontSize="10"
              Glyph="&#xE718;"
              Visibility="{Binding Pinned, Converter={StaticResource BoolToVisibility}}"
              Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
              VerticalAlignment="Center"
            />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Status Bar -->
    <Grid Grid.Row="2" Padding="8,4" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Text="{Binding ViewModel.StatusText}"
        FontSize="11"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center"
      />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button
          Content="Settings"
          Click="SettingsButton_Click"
          Style="{StaticResource SubtleButtonStyle}"
          FontSize="11"
          Padding="8,2"
        />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
