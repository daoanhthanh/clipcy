<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Clipcy.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Clipcy"
  xmlns:services="using:Clipcy.Services"
  xmlns:vm="using:Clipcy.ViewModels"
>
  <Grid
    x:Name="RootGrid"
    PreviewKeyDown="RootGrid_KeyDown"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    Padding="8"
    IsTabStop="True"
  >
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FocusedRowBrush" Color="Black" Opacity="0.10" />
            <SolidColorBrush x:Key="FocusedRowPointerOverBrush" Color="Black" Opacity="0.14" />
            <SolidColorBrush x:Key="FocusedRowPressedBrush" Color="Black" Opacity="0.18" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="FocusedRowBrush" Color="White" Opacity="0.12" />
            <SolidColorBrush x:Key="FocusedRowPointerOverBrush" Color="White" Opacity="0.16" />
            <SolidColorBrush x:Key="FocusedRowPressedBrush" Color="White" Opacity="0.20" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FocusedRowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusedRowPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusedRowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      <!-- Row height matches WindowService.PinnedRowHeightDip. -->
      <Style x:Key="ClipboardRowStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <!-- Keep highlight spacing explicit; native presenter chrome adds its own inset. -->
              <Grid x:Name="RowRoot" Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="RowBackground.Background"
                                Value="{ThemeResource ListViewItemBackgroundPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="RowBackground.Background"
                                Value="{ThemeResource ListViewItemBackgroundPressed}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <VisualState.Setters>
                        <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                        <Setter Target="RowBackground.Background"
                                Value="{ThemeResource FocusedRowBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOverSelected">
                      <VisualState.Setters>
                        <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                        <Setter Target="RowBackground.Background"
                                Value="{ThemeResource FocusedRowPointerOverBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PressedSelected">
                      <VisualState.Setters>
                        <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                        <Setter Target="RowBackground.Background"
                                Value="{ThemeResource FocusedRowPressedBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="RowRoot.Opacity"
                                Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="RowBackground"
                        Margin="0,0,0,1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6" />
                <Border x:Name="SelectionIndicator"
                        Margin="0,0,0,1"
                        BorderThickness="0,0,2,0"
                        BorderBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ClipboardItemTemplate" x:DataType="services:ClipboardItemViewModel">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid.ContextFlyout>
            <MenuFlyout>
              <MenuFlyoutItem
                Text="{x:Bind PinUnpinText, Mode=OneWay}"
                Click="PinUnpinMenuItem_Click"
              />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem services:Localization.Text="common.delete" Click="DeleteMenuItem_Click" />
            </MenuFlyout>
          </Grid.ContextFlyout>

          <FontIcon
            Grid.Column="0"
            FontSize="14"
            Glyph="{x:Bind ContentTypeIcon, Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            VerticalAlignment="Center"
          />

          <Grid Grid.Column="1" ColumnSpacing="0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
              Grid.Column="0"
              CornerRadius="3"
              BorderThickness="1"
              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
              Margin="0,0,6,0"
              Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
              VerticalAlignment="Center"
            >
              <Image
                Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                Width="30"
                Height="30"
                Stretch="UniformToFill"
              />
            </Border>

            <TextBlock
              Grid.Column="1"
              Text="{x:Bind DisplayPreview, Mode=OneWay}"
              TextTrimming="CharacterEllipsis"
              MaxLines="1"
              MaxWidth="280"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              FontSize="13"
            />

            <FontIcon
              Grid.Column="2"
              FontSize="11"
              Glyph="&#xE751;"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Visibility="{x:Bind MultiLineIndicatorVisibility, Mode=OneWay}"
              Margin="2,0,0,0"
              VerticalAlignment="Center"
            />
          </Grid>

          <FontIcon
            Grid.Column="2"
            FontSize="10"
            Glyph="&#xE718;"
            Visibility="{x:Bind PinnedVisibility, Mode=OneWay}"
            Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
            VerticalAlignment="Center"
          />
          <TextBlock
            Grid.Column="3"
            Text="{x:Bind ShortcutLabel, Mode=OneWay}"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
          />
        </Grid>
      </DataTemplate>
      </ResourceDictionary>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search Box -->
    <TextBox
      x:Name="SearchBox"
      Grid.Row="0"
      Margin="4,4,4,4"
      services:Localization.PlaceholderText="main.search_placeholder"
      TextChanged="SearchBox_TextChanged"
      GotFocus="SearchBox_GotFocus"
      BorderThickness="0"
      Background="{ThemeResource ControlFillColorDefaultBrush}"
    />

    <!-- Pinned items: at most 3 rows visible; further pins scroll here. -->
    <ListView
      x:Name="PinnedListView"
      Grid.Row="1"
      Margin="0,4,0,0"
      Padding="0,0,8,0"
      ItemsSource="{Binding ViewModel.PinnedItems}"
      ItemTemplate="{StaticResource ClipboardItemTemplate}"
      ItemContainerStyle="{StaticResource ClipboardRowStyle}"
      SelectionMode="Single"
      ItemClick="HistoryListView_ItemClick"
      IsItemClickEnabled="True"
      SingleSelectionFollowsFocus="False"
      IsTabStop="False"
      Background="Transparent"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.VerticalScrollMode="Enabled"
      ScrollViewer.HorizontalScrollMode="Disabled"
      Visibility="{Binding ViewModel.HasPinnedItems, Converter={StaticResource BoolToVisibility}}"
      ContainerContentChanging="HistoryListView_ContainerContentChanging"
      SelectionChanged="ClipboardList_SelectionChanged"
      Loaded="HistoryListView_Loaded"
    />

    <Border
      x:Name="PinnedSeparator"
      Grid.Row="2"
      Height="1"
      Margin="8,4,8,0"
      Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
      Visibility="{Binding ViewModel.HasPinnedItems, Converter={StaticResource BoolToVisibility}}"
    />

    <!-- Regular clipboard history -->
    <ListView
      x:Name="HistoryListView"
      Grid.Row="3"
      Margin="0,4,0,0"
      Padding="0,0,8,0"
      ItemsSource="{Binding ViewModel.RegularItems}"
      ItemTemplate="{StaticResource ClipboardItemTemplate}"
      ItemContainerStyle="{StaticResource ClipboardRowStyle}"
      SelectionMode="Single"
      ItemClick="HistoryListView_ItemClick"
      IsItemClickEnabled="True"
      SingleSelectionFollowsFocus="False"
      IsTabStop="False"
      Background="Transparent"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.VerticalScrollMode="Enabled"
      ScrollViewer.HorizontalScrollMode="Disabled"
      ContainerContentChanging="HistoryListView_ContainerContentChanging"
      SelectionChanged="ClipboardList_SelectionChanged"
      Loaded="HistoryListView_Loaded"
    />

    <!-- Status Bar -->
    <Grid Grid.Row="4" Padding="8,4" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Text="{Binding ViewModel.StatusText}"
        FontSize="11"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center"
      />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button
          services:Localization.Content="common.settings"
          Click="SettingsButton_Click"
          Style="{StaticResource SubtleButtonStyle}"
          FontSize="11"
          Padding="8,2"
        />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
