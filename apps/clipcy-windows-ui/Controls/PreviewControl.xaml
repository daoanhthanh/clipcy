<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="Clipcy.Controls.PreviewControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="using:Clipcy.Services"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <DataTemplate x:Key="PreviewTableCellTemplate">
      <Border Padding="6,4,6,4" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
        <TextBlock
          Text="{Binding}"
          FontSize="12"
          LineHeight="16"
          TextWrapping="Wrap"
          MaxLines="2"
          TextTrimming="CharacterEllipsis"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
        />
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border
    x:Name="RootBorder"
    Width="360"
    MaxHeight="400"
    CornerRadius="8"
    BorderThickness="1"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    Background="Transparent"
    Translation="0,0,32"
  >
    <Border.Shadow>
      <ThemeShadow />
    </Border.Shadow>

    <Grid Padding="12,10,12,12" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock
          x:Name="ContentTypeText"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
        />

        <!-- Multi-file selector (Files only; hidden for single file) -->
        <Grid x:Name="FileSelectorRow" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox
            x:Name="FileSelector"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            IsEditable="False"
            SelectionChanged="FileSelector_SelectionChanged"
          />
          <TextBlock
            x:Name="FileCountText"
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          />
        </Grid>

        <TextBlock
          x:Name="FileNameText"
          FontSize="12"
          TextWrapping="NoWrap"
          TextTrimming="CharacterEllipsis"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Visibility="Collapsed"
        />
      </StackPanel>


      <!-- Content -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
        <StackPanel Spacing="10">
          <!-- Status / loading for file previews -->
          <TextBlock
            x:Name="FileStatusText"
            TextWrapping="Wrap"
            FontSize="13"
            LineHeight="20"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed"
          />

          <!-- Text Content -->
          <TextBlock
            x:Name="PreviewText"
            TextWrapping="Wrap"
            FontSize="13"
            LineHeight="20"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Visibility="Collapsed"
            IsTextSelectionEnabled="True"
          />

          <!-- RTF Content -->
          <RichEditBox
            x:Name="PreviewRichText"
            IsReadOnly="True"
            FontSize="13"
            BorderThickness="0"
            Padding="0"
            Background="Transparent"
            Visibility="Collapsed"
          />

          <!-- Table Content -->
          <Border
            x:Name="PreviewTableBorder"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed"
          >
            <Grid x:Name="PreviewTable" />
          </Border>

          <!-- Image Content -->
          <Border x:Name="PreviewImageBorder" CornerRadius="4" Visibility="Collapsed">
            <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="336" MaxHeight="260" />
          </Border>

          <!-- Audio: music-note icon only (no waveform decode) -->
          <StackPanel
            x:Name="AudioIconPanel"
            Orientation="Vertical"
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed"
          >
            <SymbolIcon
              x:Name="AudioSymbol"
              Symbol="Audio"
              Width="48"
              Height="48"
            />
            <TextBlock
              x:Name="AudioFileNameText"
              FontSize="12"
              HorizontalAlignment="Center"
              TextWrapping="Wrap"
              TextAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- Metadata Footer -->
      <StackPanel Grid.Row="2" Spacing="4">
        <Border
          Height="1"
          Margin="0,6,0,6"
          Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Spacing="2">
            <StackPanel
              x:Name="SourceAppRow"
              Orientation="Horizontal"
              Spacing="6"
              Visibility="Collapsed"
              VerticalAlignment="Center"
            >
              <Image x:Name="SourceAppIcon" Width="14" Height="14" Visibility="Collapsed" />
              <TextBlock
                x:Name="SourceAppText"
                FontSize="11"
                LineHeight="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
            </StackPanel>

            <TextBlock
              x:Name="MetadataText"
              FontSize="11"
              TextWrapping="Wrap"
              LineHeight="16"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
            <TextBlock
              FontSize="11"
              LineHeight="16"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              services:Localization.Text="preview.hint_pin"
            />
            <TextBlock
              FontSize="11"
              LineHeight="16"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              services:Localization.Text="preview.hint_delete"
            />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
