<?xml version="1.0" encoding="utf-8" ?>
<UserControl
  x:Class="Clipcy.Controls.PreviewControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="using:Clipcy.Services"
  xmlns:media="using:Microsoft.UI.Xaml.Media"
  mc:Ignorable="d"
>
  <Border
    x:Name="RootBorder"
    Width="360"
    MaxHeight="400"
    CornerRadius="8"
    BorderThickness="1"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    Translation="0,0,32"
  >
    <Border.Background>
      <media:AcrylicBrush
        TintColor="{ThemeResource LayerFillColorDefault}"
        TintOpacity="0.5"
        TintLuminosityOpacity="0.5"
        FallbackColor="{ThemeResource LayerFillColorDefault}"
      />
    </Border.Background>
    <Border.Shadow>
      <ThemeShadow />
    </Border.Shadow>

    <Grid Padding="12,10,12,12" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <TextBlock
        x:Name="ContentTypeText"
        Grid.Row="0"
        FontSize="13"
        FontWeight="SemiBold"
        Margin="0,0,0,4"
        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
        Text="Loading..."
      />

      <!-- Content -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
        <StackPanel Spacing="10">
          <!-- Text Content -->
          <TextBlock
            x:Name="PreviewText"
            TextWrapping="Wrap"
            FontSize="13"
            LineHeight="20"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Visibility="Collapsed"
          />

          <!-- RTF Content -->
          <RichEditBox
            x:Name="PreviewRichText"
            IsReadOnly="True"
            FontSize="13"
            BorderThickness="0"
            Padding="0"
            Background="Transparent"
            Visibility="Collapsed"
          />

          <!-- Table Content -->
          <Border
            x:Name="PreviewTableBorder"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed"
          >
            <Grid x:Name="PreviewTable" />
          </Border>

          <!-- Image Content -->
          <Border x:Name="PreviewImageBorder" CornerRadius="4" Visibility="Collapsed">
            <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="336" MaxHeight="260" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Metadata Footer -->
      <StackPanel Grid.Row="2" Spacing="4">
        <Border
          Height="1"
          Margin="0,6,0,6"
          Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Spacing="2">
            <StackPanel
              x:Name="SourceAppRow"
              Orientation="Horizontal"
              Spacing="6"
              Visibility="Collapsed"
              VerticalAlignment="Center"
            >
              <Image
                x:Name="SourceAppIcon"
                Width="14"
                Height="14"
                Visibility="Collapsed"
              />
              <TextBlock
                x:Name="SourceAppText"
                FontSize="11"
                LineHeight="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              />
            </StackPanel>

            <TextBlock
              x:Name="MetadataText"
              FontSize="11"
              TextWrapping="Wrap"
              LineHeight="16"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
            <TextBlock
              FontSize="11"
              LineHeight="16"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              Text="Ctrl+P to pin"
            />
            <TextBlock
              FontSize="11"
              LineHeight="16"
              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
              Text="Del to delete"
            />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
