<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Clipcy.Controls">

  <!-- Settings Card Border Style -->
  <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="24,20" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style TargetType="local:SettingsCard">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SettingsCard">
          <Border Style="{StaticResource SettingsCardBorderStyle}">
            <Grid HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Header Icon (optional) -->
              <ContentPresenter
                Grid.Column="0"
                Content="{TemplateBinding HeaderIcon}"
                VerticalAlignment="Center"
                Margin="0,0,16,0"
                Visibility="{TemplateBinding HeaderIconVisibility}"
              />

              <!-- Header and Description -->
              <StackPanel 
                Grid.Column="1" 
                VerticalAlignment="Center"
                Visibility="{TemplateBinding HeaderVisibility}">
                <TextBlock
                  Text="{TemplateBinding Header}"
                  Style="{StaticResource BodyStrongTextBlockStyle}"
                  Visibility="{TemplateBinding HeaderTextVisibility}"
                />
                <TextBlock
                  Text="{TemplateBinding Description}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,2,0,0"
                  Visibility="{TemplateBinding DescriptionVisibility}"
                />
              </StackPanel>

              <!-- Content (right side - typically a control like ToggleSwitch, NumberBox, etc.) -->
              <ContentPresenter
                Grid.Column="2"
                Content="{TemplateBinding Content}"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
              />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>


