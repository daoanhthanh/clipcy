<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Clipcy</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
  </ItemGroup>

  <!-- Copy Rust DLL to output directory -->
  <ItemGroup>
    <Content Include="..\..\target\release\clipcy_core.dll" Link="clipcy_core.dll"
      CopyToOutputDirectory="PreserveNewest"
      Condition="Exists('..\..\target\release\clipcy_core.dll')" />
    <Content Include="..\..\target\debug\clipcy_core.dll" Link="clipcy_core.dll"
      CopyToOutputDirectory="PreserveNewest"
      Condition="!Exists('..\..\target\release\clipcy_core.dll') And Exists('..\..\target\debug\clipcy_core.dll')" />
  </ItemGroup>

  <!-- Application icon -->
  <ItemGroup>
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
