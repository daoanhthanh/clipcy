<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
  x:Class="Clipcy.ShortcutPickerDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Edit Hotkey"
>
  <StackPanel Spacing="16" MinWidth="460">
    <StackPanel Spacing="6">
      <TextBlock Text="Press keys to set a new hotkey combination." TextWrapping="Wrap" />
      <TextBlock
        Text="Pause 1 second to start a new combination."
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        TextWrapping="Wrap"
      />
    </StackPanel>

    <Border
      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="16"
    >
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <TextBlock
          Text="Listening for keys"
          Style="{StaticResource BodyTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button
            x:Name="WinKeyButton"
            Content="Win"
            MinWidth="56"
            Height="44"
            Padding="12,0"
            Style="{ThemeResource AccentButtonStyle}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
          />
          <Button
            x:Name="CtrlKeyButton"
            Content="Ctrl"
            MinWidth="56"
            Height="44"
            Padding="12,0"
            Style="{ThemeResource AccentButtonStyle}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
          />
          <Button
            x:Name="AltKeyButton"
            Content="Alt"
            MinWidth="56"
            Height="44"
            Padding="12,0"
            Style="{ThemeResource AccentButtonStyle}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
          />
          <Button
            x:Name="ShiftKeyButton"
            Content="Shift"
            MinWidth="56"
            Height="44"
            Padding="12,0"
            Style="{ThemeResource AccentButtonStyle}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
          />
          <Button
            x:Name="MainKeyButton"
            Content=""
            MinWidth="56"
            Height="44"
            Padding="12,0"
            Style="{ThemeResource AccentButtonStyle}"
            Visibility="Collapsed"
            IsHitTestVisible="False"
          />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Reset" Click="Reset_Click" />
      <Button Content="Clear" Click="Clear_Click" />
    </StackPanel>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        Grid.Column="0"
        Content="Save"
        Click="Save_Click"
        CornerRadius="4"
        Style="{ThemeResource AccentButtonStyle}"
        HorizontalAlignment="Stretch"
      />
      <Button
        Grid.Column="1"
        Content="Cancel"
        Click="Cancel_Click"
        CornerRadius="4"
        Style="{ThemeResource DefaultButtonStyle}"
        HorizontalAlignment="Stretch"
      />
    </Grid>
  </StackPanel>
</ContentDialog>
