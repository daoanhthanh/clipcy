<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
  x:Class="Clipcy.ShortcutPickerDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Edit Hotkey"
>
  <StackPanel Spacing="16" MinWidth="400">
    <TextBlock Text="Press keys to set a new hotkey combination..." TextWrapping="Wrap" />

    <!-- Keyboard preview -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Padding="20">
      <Button
        x:Name="WinKeyButton"
        Content="Win"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="CtrlKeyButton"
        Content="Ctrl"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="AltKeyButton"
        Content="Alt"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="ShiftKeyButton"
        Content="Shift"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="MainKeyButton"
        Content=""
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
    </StackPanel>

    <!-- Action buttons -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="Reset" Click="Reset_Click" />
      <Button Content="Clear" Click="Clear_Click" />
    </StackPanel>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        Grid.Column="0"
        Content="Save"
        Click="Save_Click"
        CornerRadius="4"
        Style="{ThemeResource AccentButtonStyle}"
        HorizontalAlignment="Stretch"
      />
      <Button
        Grid.Column="1"
        Content="Cancel"
        Click="Cancel_Click"
        CornerRadius="4"
        Style="{ThemeResource DefaultButtonStyle}"
        HorizontalAlignment="Stretch"
      />
    </Grid>
  </StackPanel>
</ContentDialog>
