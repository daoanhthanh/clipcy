<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
  x:Class="Clipcy.ShortcutPickerDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Edit Hotkey"
  PrimaryButtonText="Save"
  CloseButtonText="Cancel"
  DefaultButton="Primary"
  PrimaryButtonClick="PrimaryButton_Click"
  CloseButtonClick="CloseButton_Click"
>
  <StackPanel Spacing="16" MinWidth="400">
    <TextBlock Text="Press keys to set a new hotkey combination..." TextWrapping="Wrap" />

    <!-- Keyboard preview -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Padding="20">
      <Button
        x:Name="WinKeyButton"
        Content="Win"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="CtrlKeyButton"
        Content="Ctrl"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="AltKeyButton"
        Content="Alt"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="ShiftKeyButton"
        Content="Shift"
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
      <Button
        x:Name="MainKeyButton"
        Content=""
        Width="56"
        Height="48"
        Style="{ThemeResource AccentButtonStyle}"
        Visibility="Collapsed"
      />
    </StackPanel>

    <!-- Action buttons -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button Content="Reset" Click="Reset_Click" />
      <Button Content="Clear" Click="Clear_Click" />
    </StackPanel>
  </StackPanel>
</ContentDialog>
