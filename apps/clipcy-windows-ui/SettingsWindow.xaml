<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Clipcy.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Clipcy"
  xmlns:controls="using:Clipcy.Controls"
  Title="Settings"
>
  <Grid x:Name="RootGrid" Background="Transparent" SizeChanged="RootGrid_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar drag region -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="8">
        <!-- Hamburger menu button (shown when sidebar is collapsed) -->
        <Button
          x:Name="HamburgerButton"
          Width="40"
          Height="40"
          Background="Transparent"
          BorderThickness="0"
          Padding="0"
          Click="HamburgerButton_Click"
          Visibility="Collapsed"
        >
          <FontIcon Glyph="&#xE700;" FontSize="16" />
        </Button>
        <FontIcon Glyph="&#xE713;" FontSize="16" />
        <TextBlock
          Text="Settings"
          Style="{StaticResource BodyTextBlockStyle}"
          VerticalAlignment="Center"
        />
      </StackPanel>
    </Grid>

    <!-- Main Content Area -->
    <Grid Grid.Row="1">
      <!-- Content Panel (always full width) -->
      <Grid x:Name="ContentAreaGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Spacer for sidebar in expanded mode -->
        <Border x:Name="SidebarSpacer" Grid.Column="0" />

        <!-- Content takes the right column in expanded mode, or full width in compact -->
        <Grid x:Name="ContentPanel" Grid.Column="1" Background="Transparent">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Page content area -->
          <ScrollViewer Grid.Row="0" Padding="24,32,24,32">
            <Grid x:Name="ContentHost" MaxWidth="2400" HorizontalAlignment="Stretch">
              <!-- General Page -->
              <StackPanel
                x:Name="GeneralPage"
                Spacing="8"
                Visibility="Visible"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  Text="General"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  Text="Configure basic clipboard settings"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <!-- Max History Items -->
                <controls:SettingsCard
                  Header="Maximum history items"
                  Description="Number of clipboard items to keep (10-1000)"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE81C;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <NumberBox
                    x:Name="MaxHistoryBox"
                    MinWidth="120"
                    Minimum="10"
                    Maximum="1000"
                    SpinButtonPlacementMode="Hidden"
                    ValueChanged="MaxHistoryBox_ValueChanged"
                    LostFocus="MaxHistoryBox_LostFocus"
                    VerticalAlignment="Center"
                  />
                </controls:SettingsCard>

                <!-- Hotkey -->
                <controls:SettingsCard
                  Header="Keyboard shortcut"
                  Description="Global hotkey to open clipboard history"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE765;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Border
                        x:Name="WinKeyDisplayButton"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Visibility="Collapsed"
                      >
                        <TextBlock Text="Win" FontSize="12" VerticalAlignment="Center" />
                      </Border>
                      <Border
                        x:Name="CtrlKeyDisplayButton"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Visibility="Collapsed"
                      >
                        <TextBlock Text="Ctrl" FontSize="12" VerticalAlignment="Center" />
                      </Border>
                      <Border
                        x:Name="AltKeyDisplayButton"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Visibility="Collapsed"
                      >
                        <TextBlock Text="Alt" FontSize="12" VerticalAlignment="Center" />
                      </Border>
                      <Border
                        x:Name="ShiftKeyDisplayButton"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Visibility="Collapsed"
                      >
                        <TextBlock Text="Shift" FontSize="12" VerticalAlignment="Center" />
                      </Border>
                      <Border
                        x:Name="MainKeyDisplayButton"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        Visibility="Collapsed"
                      >
                        <TextBlock
                          x:Name="MainKeyDisplayText"
                          Text=""
                          FontSize="12"
                          VerticalAlignment="Center"
                        />
                      </Border>
                    </StackPanel>

                    <Button Content="Change" Click="EditHotkey_Click" />
                  </StackPanel>
                </controls:SettingsCard>
              </StackPanel>

              <!-- Behavior Page -->
              <StackPanel
                x:Name="BehaviorPage"
                Spacing="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  Text="Behavior"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  Text="Control how Clipcy behaves"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <!-- Start on boot -->
                <controls:SettingsCard
                  Header="Start on boot"
                  Description="Launch Clipcy when Windows starts"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE7E8;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="StartOnBootToggle"
                    Toggled="StartOnBootToggle_Toggled"
                    OnContent=""
                    OffContent=""
                  />
                </controls:SettingsCard>

                <!-- Show preview panel -->
                <controls:SettingsCard
                  Header="Show preview panel"
                  Description="Display content preview in the popup"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE8A1;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="ShowPreviewToggle"
                    Toggled="ShowPreviewToggle_Toggled"
                    OnContent=""
                    OffContent=""
                  />
                </controls:SettingsCard>

                <!-- Show notifications -->
                <controls:SettingsCard
                  Header="Show notifications"
                  Description="Notify when clipboard content changes"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE91C;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch
                    x:Name="ShowNotificationsToggle"
                    Toggled="ShowNotificationsToggle_Toggled"
                    OnContent=""
                    OffContent=""
                  />
                </controls:SettingsCard>
              </StackPanel>

              <!-- Appearance Page -->
              <StackPanel
                x:Name="AppearancePage"
                Spacing="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  Text="Appearance"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  Text="Customize the look and feel"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <!-- Theme -->
                <controls:SettingsCard
                  Header="App theme"
                  Description="Choose between light, dark, or system theme"
                >
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE793;"
                      FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <ComboBox
                    x:Name="ThemeComboBox"
                    MinWidth="150"
                    SelectionChanged="ThemeComboBox_SelectionChanged"
                    VerticalAlignment="Center"
                  >
                    <ComboBoxItem Content="Use system setting" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                  </ComboBox>
                </controls:SettingsCard>
              </StackPanel>

              <!-- About Page -->
              <StackPanel
                x:Name="AboutPage"
                Spacing="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                MaxWidth="{Binding ElementName=ContentHost, Path=ActualWidth}"
              >
                <TextBlock
                  Text="About"
                  Style="{StaticResource TitleTextBlockStyle}"
                  Margin="0,0,0,8"
                />
                <TextBlock
                  Text="Application information"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Margin="0,0,0,24"
                />

                <controls:SettingsCard Header="Clipcy" Description="Clipboard Manager for Windows">
                  <controls:SettingsCard.HeaderIcon>
                    <FontIcon
                      Glyph="&#xE8C8;"
                      FontSize="24"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    />
                  </controls:SettingsCard.HeaderIcon>
                  <TextBlock
                    Text="Version 1.0.0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    VerticalAlignment="Center"
                  />
                </controls:SettingsCard>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Overlay backdrop for compact mode (click to close sidebar) -->
      <Border
        x:Name="SidebarOverlayBackdrop"
        Background="#80000000"
        Visibility="Collapsed"
        Tapped="SidebarOverlayBackdrop_Tapped"
      />

      <!-- Sidebar Panel (overlays content in compact mode) -->
      <Grid x:Name="SidebarPanel" Width="280" HorizontalAlignment="Left">
        <!-- Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" -->
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
          x:Name="NavListView"
          Grid.Row="0"
          Padding="12,8"
          SelectionMode="Single"
          SelectedIndex="0"
          Background="Transparent"
          SelectionChanged="NavListView_SelectionChanged"
        >
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="12,10" />
              <Setter Property="Margin" Value="4,2" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>

          <ListViewItem Tag="General">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE115;" FontSize="16" />
              <TextBlock Text="General" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>

          <ListViewItem Tag="Behavior">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE9E9;" FontSize="16" />
              <TextBlock Text="Behavior" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>

          <ListViewItem Tag="Appearance">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE790;" FontSize="16" />
              <TextBlock Text="Appearance" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>

          <ListViewItem Tag="About">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <FontIcon Glyph="&#xE946;" FontSize="16" />
              <TextBlock Text="About" VerticalAlignment="Center" />
            </StackPanel>
          </ListViewItem>
        </ListView>

        <!-- Reset button at bottom of sidebar -->
        <Button
          Content="Reset to Defaults"
          Grid.Row="1"
          Margin="16,8,16,16"
          HorizontalAlignment="Stretch"
          Click="ResetButton_Click"
        />
      </Grid>
    </Grid>
  </Grid>
</Window>
