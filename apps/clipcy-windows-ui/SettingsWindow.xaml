<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="Clipcy.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Clipcy"
  Title="Clipcy Settings"
>
  <Grid Background="Transparent">
    <ScrollViewer Background="Transparent">
      <StackPanel Padding="24" Spacing="24">
      <!-- Header -->
      <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

      <!-- General Settings -->
      <StackPanel Spacing="16">
        <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />

        <!-- Max History Items -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Maximum history items" />
            <TextBlock
              Text="Number of clipboard items to keep in history. Maximum is 1000"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <NumberBox
            x:Name="MaxHistoryBox"
            Grid.Column="1"
            Width="120"
            Minimum="10"
            Maximum="1000"
            SpinButtonPlacementMode="Hidden"
            ValueChanged="MaxHistoryBox_ValueChanged"
            LostFocus="MaxHistoryBox_LostFocus"
          />
        </Grid>

        <!-- Hotkey -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Hotkey" />
            <TextBlock
              Text="Global shortcut to show clipboard history"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <TextBox
            x:Name="HotkeyBox"
            Grid.Column="1"
            Width="150"
            IsReadOnly="True"
            PlaceholderText="Click to set..."
            GotFocus="HotkeyBox_GotFocus"
            KeyDown="HotkeyBox_KeyDown"
          />
        </Grid>
      </StackPanel>

      <!-- Behavior Settings -->
      <StackPanel Spacing="16">
        <TextBlock Text="Behavior" Style="{StaticResource SubtitleTextBlockStyle}" />

        <!-- Start on boot -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Start on boot" />
            <TextBlock
              Text="Launch Clipcy when Windows starts"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <ToggleSwitch
            x:Name="StartOnBootToggle"
            Grid.Column="1"
            Toggled="StartOnBootToggle_Toggled"
          />
        </Grid>

        <!-- Show preview panel -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Show preview panel" />
            <TextBlock
              Text="Display content preview in the popup window"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <ToggleSwitch
            x:Name="ShowPreviewToggle"
            Grid.Column="1"
            Toggled="ShowPreviewToggle_Toggled"
          />
        </Grid>

        <!-- Show notifications -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Show notifications" />
            <TextBlock
              Text="Display notifications when clipboard content changes"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <ToggleSwitch
            x:Name="ShowNotificationsToggle"
            Grid.Column="1"
            Toggled="ShowNotificationsToggle_Toggled"
          />
        </Grid>
      </StackPanel>

      <!-- Appearance Settings -->
      <StackPanel Spacing="16">
        <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" />

        <!-- Theme -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="Theme" />
            <TextBlock
              Text="Choose light, dark, or system theme"
              Style="{StaticResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            />
          </StackPanel>

          <ComboBox
            x:Name="ThemeComboBox"
            Grid.Column="1"
            Width="150"
            SelectionChanged="ThemeComboBox_SelectionChanged"
          >
            <ComboBoxItem Content="System" Tag="System" />
            <ComboBoxItem Content="Light" Tag="Light" />
            <ComboBoxItem Content="Dark" Tag="Dark" />
          </ComboBox>
        </Grid>
      </StackPanel>

      <!-- About Section -->
      <StackPanel Spacing="8">
        <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock Text="Clipcy - Clipboard Manager" />
        <TextBlock
          Text="Version 1.0.0"
          Style="{StaticResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
      </StackPanel>

      <!-- Action Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Reset to Defaults" Click="ResetButton_Click" />
        <Button
          Content="Save"
          Style="{StaticResource AccentButtonStyle}"
          Click="SaveButton_Click"
        />
      </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
